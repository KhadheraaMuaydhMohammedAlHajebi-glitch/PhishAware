# Reverse proxy for PhishAware (NFR-08).
#
# Caddy obtains and renews the TLS certificate for PHISHAWARE_DOMAIN by itself
# and redirects plain HTTP to HTTPS. For "localhost" it issues a certificate from
# its own local authority, which is how the CI pipeline exercises the HTTPS path.
#
# There is deliberately no "log" directive: an access log would record client IP
# addresses, which the consent form promises not to collect (NFR-11).
{$PHISHAWARE_DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy app:8000
}
