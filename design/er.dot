digraph ER { rankdir=LR; graph[fontname="Liberation Serif", pad=0.2, nodesep=0.5]; node[shape=plaintext, fontname="Liberation Serif", fontsize=10]; edge[fontname="Liberation Serif", fontsize=9, color="#34495E"];
 P [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#2E86C1"><font color="white"><b>PARTICIPANT</b></font></td></tr><tr><td align="left">participant_id (PK, random UUID)</td></tr><tr><td align="left">consent_version</td></tr><tr><td align="left">consent_timestamp</td></tr><tr><td align="left">status (active/complete/withdrawn)</td></tr></table>>];
 A [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1E8449"><font color="white"><b>ATTEMPT</b></font></td></tr><tr><td align="left">attempt_id (PK)</td></tr><tr><td align="left">participant_id (FK)</td></tr><tr><td align="left">phase (pre / practice / post)</td></tr><tr><td align="left">score_percent</td></tr><tr><td align="left">completed_at</td></tr></table>>];
 R [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1E8449"><font color="white"><b>RESPONSE</b></font></td></tr><tr><td align="left">response_id (PK)</td></tr><tr><td align="left">attempt_id (FK)</td></tr><tr><td align="left">scenario_id (FK)</td></tr><tr><td align="left">answer (phish / legitimate)</td></tr><tr><td align="left">is_correct</td></tr></table>>];
 S [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#7D3C98"><font color="white"><b>SCENARIO</b></font></td></tr><tr><td align="left">scenario_id (PK)</td></tr><tr><td align="left">channel (email / web page)</td></tr><tr><td align="left">cue_category</td></tr><tr><td align="left">difficulty (1–3)</td></tr><tr><td align="left">correct_label</td></tr><tr><td align="left">explanation_text</td></tr></table>>];
 U [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#CA6F1E"><font color="white"><b>SUS_RESPONSE</b></font></td></tr><tr><td align="left">sus_id (PK)</td></tr><tr><td align="left">participant_id (FK)</td></tr><tr><td align="left">q1 … q10 (1–5)</td></tr><tr><td align="left">sus_score (0–100)</td></tr></table>>];
 D [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#C0392B"><font color="white"><b>ADMIN_USER</b></font></td></tr><tr><td align="left">admin_id (PK)</td></tr><tr><td align="left">username</td></tr><tr><td align="left">password_hash</td></tr><tr><td align="left">role</td></tr></table>>];
 P->A[label="1 : N"]; A->R[label="1 : N"]; S->R[label="1 : N"]; P->U[label="1 : 0..1"];
}
