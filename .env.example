# PhishAware deployment settings.
# Copy this file to .env and fill in the two secrets. The real .env is ignored
# by Git and by the image build, and must never be committed.

# "production" switches on the start-up checks, Secure cookies, and HSTS.
PHISHAWARE_ENV=production

# Signs session cookies (at least 32 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
PHISHAWARE_SECRET_KEY=

# Encrypts database backups. Keep a copy away from the server: a backup cannot
# be restored without it. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHISHAWARE_BACKUP_KEY=

# Public host name. The proxy obtains the HTTPS certificate for it automatically.
PHISHAWARE_DOMAIN=localhost

# Days after consent before "flask purge-expired" deletes a participant's records.
PHISHAWARE_RETENTION_DAYS=90

# Server sizing: worker processes, and threads in each.
WEB_CONCURRENCY=2
PHISHAWARE_THREADS=4

# Host ports published by the reverse proxy.
PHISHAWARE_HTTP_PORT=80
PHISHAWARE_HTTPS_PORT=443
